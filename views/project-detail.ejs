<!-- Project Detail Page -->
<section class="project-detail-section">
  <div class="container">

    <!-- Back Navigation -->
    <a href="/projects" class="back-link">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="19" y1="12" x2="5" y2="12"/>
        <polyline points="12 19 5 12 12 5"/>
      </svg>
      <span>Back to Projects</span>
    </a>

    <!-- Project Header -->
    <div class="pd-header animate-fade-in-up">
      <div class="pd-meta">
        <div class="project-status">
          <span class="status-dot <%= project.status === 'shipped' ? 'shipped' : project.status === 'in-progress' ? 'in-progress' : 'archived' %>"></span>
          <span><%= project.status === 'in-progress' ? 'In Progress' : project.status.charAt(0).toUpperCase() + project.status.slice(1) %></span>
        </div>
        <% if (project.featured) { %>
        <div class="featured-badge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
          <span>Featured</span>
        </div>
        <% } %>
        <span class="pd-year"><%= project.year %></span>
      </div>

      <h1 class="pd-title"><%= project.title %></h1>
      <p class="pd-description"><%= project.description %></p>

      <!-- Action Buttons -->
      <div class="pd-actions">
        <% if (project.github_url) { %>
        <a href="<%= project.github_url %>" target="_blank" rel="noopener noreferrer" class="btn-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
          </svg>
          <span class="btn-text">View Source</span>
          <span class="btn-bg"></span>
        </a>
        <% } %>
        <% if (project.live_url) { %>
        <a href="<%= project.live_url %>" target="_blank" rel="noopener noreferrer" class="btn-secondary pd-live-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
          <span>Live Demo</span>
          <span class="btn-arrow">&rarr;</span>
        </a>
        <% } %>
      </div>
    </div>

    <!-- Main Content Grid -->
    <div class="pd-grid">

      <!-- Left Column: Main Info -->
      <div class="pd-main">

        <!-- Long Description / Overview -->
        <% if (project.long_description) { %>
        <div class="pd-card animate-fade-in-up stagger-2">
          <div class="pd-card-header">
            <div class="pd-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
              </svg>
            </div>
            <h2>Overview</h2>
          </div>
          <div class="pd-card-body">
            <div class="pd-long-desc"><%- project.long_description.replace(/\n/g, '<br>') %></div>
          </div>
        </div>
        <% } else { %>
        <div class="pd-card animate-fade-in-up stagger-2">
          <div class="pd-card-header">
            <div class="pd-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
              </svg>
            </div>
            <h2>Overview</h2>
          </div>
          <div class="pd-card-body">
            <div class="pd-long-desc"><%= project.description %></div>
          </div>
        </div>
        <% } %>

        <!-- Tech Stack Terminal -->
        <% if (project.tags && project.tags.length > 0) { %>
        <div class="pd-card pd-tech-card animate-fade-in-up stagger-3">
          <div class="terminal-dots">
            <span class="terminal-dot red"></span>
            <span class="terminal-dot yellow"></span>
            <span class="terminal-dot green"></span>
          </div>
          <div class="terminal-title">tech-stack.json</div>
          <div class="pd-terminal-body">
            <p><span class="terminal-comment">// Technologies powering this project</span></p>
            <p><span class="terminal-keyword">const</span> <span class="terminal-variable">stack</span> = [</p>
            <% project.tags.forEach((tag, i) => { %>
            <p class="terminal-indent"><span class="terminal-string">"<%= tag %>"</span><%= i < project.tags.length - 1 ? ',' : '' %></p>
            <% }) %>
            <p>];</p>
          </div>
        </div>
        <% } %>

      </div>

      <!-- Right Column: Sidebar -->
      <div class="pd-sidebar">

        <!-- Project Stats -->
        <div class="pd-card pd-stats-card animate-fade-in-up stagger-2">
          <div class="pd-card-header">
            <div class="pd-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="18" y1="20" x2="18" y2="10"/>
                <line x1="12" y1="20" x2="12" y2="4"/>
                <line x1="6" y1="20" x2="6" y2="14"/>
              </svg>
            </div>
            <h3>Project Stats</h3>
          </div>
          <div class="pd-stats-body">
            <div class="pd-stat-row">
              <span class="pd-stat-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                </svg>
                Stars
              </span>
              <span class="pd-stat-value"><%= project.stars || 0 %></span>
            </div>
            <div class="pd-stat-row">
              <span class="pd-stat-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="18" r="3"/>
                  <circle cx="6" cy="6" r="3"/>
                  <circle cx="18" cy="6" r="3"/>
                  <path d="M6 9v3a3 3 0 0 0 3 3h6a3 3 0 0 0 3-3V9"/>
                  <path d="M12 15V9"/>
                </svg>
                Forks
              </span>
              <span class="pd-stat-value"><%= project.forks || 0 %></span>
            </div>
            <div class="pd-stat-row">
              <span class="pd-stat-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                Year
              </span>
              <span class="pd-stat-value"><%= project.year %></span>
            </div>
            <div class="pd-stat-row">
              <span class="pd-stat-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M12 8v4l3 3"/>
                </svg>
                Status
              </span>
              <span class="pd-stat-value pd-stat-status">
                <span class="status-dot <%= project.status === 'shipped' ? 'shipped' : project.status === 'in-progress' ? 'in-progress' : 'archived' %>"></span>
                <%= project.status === 'in-progress' ? 'In Progress' : project.status.charAt(0).toUpperCase() + project.status.slice(1) %>
              </span>
            </div>
          </div>
        </div>

        <!-- Tech Tags Cloud -->
        <% if (project.tags && project.tags.length > 0) { %>
        <div class="pd-card animate-fade-in-up stagger-3">
          <div class="pd-card-header">
            <div class="pd-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
              </svg>
            </div>
            <h3>Tech Tags</h3>
          </div>
          <div class="pd-tags-cloud">
            <% project.tags.forEach(tag => { %>
            <span class="project-tag pd-tag-chip"><%= tag %></span>
            <% }) %>
          </div>
        </div>
        <% } %>

        <!-- Links -->
        <div class="pd-card animate-fade-in-up stagger-4">
          <div class="pd-card-header">
            <div class="pd-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
              </svg>
            </div>
            <h3>Links</h3>
          </div>
          <div class="pd-links-list">
            <% if (project.github_url) { %>
            <a href="<%= project.github_url %>" target="_blank" rel="noopener noreferrer" class="pd-link-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
              </svg>
              <div class="pd-link-info">
                <span class="pd-link-label">GitHub Repository</span>
                <span class="pd-link-url"><%= project.github_url.replace('https://', '') %></span>
              </div>
              <svg class="pd-link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </a>
            <% } %>
            <% if (project.live_url) { %>
            <a href="<%= project.live_url %>" target="_blank" rel="noopener noreferrer" class="pd-link-item pd-link-live">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
              </svg>
              <div class="pd-link-info">
                <span class="pd-link-label">Live Demo</span>
                <span class="pd-link-url"><%= project.live_url.replace('https://', '') %></span>
              </div>
              <svg class="pd-link-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </a>
            <% } %>
            <% if (!project.github_url && !project.live_url) { %>
            <p class="pd-no-links">No public links available for this project.</p>
            <% } %>
          </div>
        </div>

      </div>
    </div>

    <!-- Bottom CTA -->
    <div class="pd-bottom-cta animate-fade-in-up">
      <div class="pd-cta-inner">
        <div class="terminal-dots">
          <span class="terminal-dot red"></span>
          <span class="terminal-dot yellow"></span>
          <span class="terminal-dot green"></span>
        </div>
        <div class="pd-cta-content">
          <p class="terminal-comment">// Interested in working together?</p>
          <h3>Let's build something.</h3>
          <p>I'm open to freelance, collaboration, and full-time opportunities.</p>
          <div class="pd-cta-actions">
            <a href="/#contact" class="btn-primary">
              <span class="btn-text">Get In Touch</span>
              <span class="btn-bg"></span>
            </a>
            <a href="/projects" class="btn-secondary">
              <span>All Projects</span>
              <span class="btn-arrow">&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>
